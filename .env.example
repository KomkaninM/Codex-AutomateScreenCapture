# LINE API Credentials
CHANNEL_ACCESS_TOKEN=
USER_ID=
GROUP_ID=

# ngrok Settings (ngrok is run separately by the operator)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Server & Webhook Settings
PORT=5000
REPLY_UNKNOWN_COMMANDS=False

# Macro Configuration
LOGIN_MACRO_SCRIPT=login_bms.json

# Auto Logout Configuration
ENABLE_AUTO_LOGOUT=False
LOGOUT_MACRO_SCRIPT=logout.json

# Detector Configuration
DETECTOR_INTERVAL_SEC=10
CONFIDENCE_THRESHOLD=0.8

# Required webhook authentication; optional live tunnel origin override
LINE_CHANNEL_SECRET=
PUBLIC_TUNNEL_URL=

# Private bearer token for POST /internal/update-tunnel (disabled if blank)
INTERNAL_API_TOKEN=

# Desktop recording and timing
DESKTOP_WIDTH=1920
DESKTOP_HEIGHT=1080
MACRO_SETTLE_DELAY=2.0
LOGIN_WAIT_SECONDS=5
MAX_MACRO_SECONDS=35
CLOSE_MENU_MACRO=close_menu.json
TIMEZONE=Asia/Bangkok
IMAGE_TTL_SECONDS=604800
