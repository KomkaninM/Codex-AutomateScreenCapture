# LINE API Credentials
CHANNEL_ACCESS_TOKEN=
# Private mode: leave GROUP_ID blank and set USER_ID from check-id.
# Group mode: GROUP_ID takes priority over USER_ID. Both blank allow check-id only.
USER_ID=
GROUP_ID=

# ngrok Settings (the launcher starts ngrok automatically)
# Account token: https://dashboard.ngrok.com/get-started/your-authtoken
# Launcher configures this automatically; blank uses existing ngrok authentication.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# Full path to ngrok.exe; use single quotes around Windows paths.
# Example: NGROK_EXE_PATH='C:\Users\HWTHR\Downloads\ngrok.exe'
# Blank searches PATH, then the folder containing start_bot.bat.
NGROK_EXE_PATH='C:\Users\HWTHR\Downloads\ngrok.exe'

# Server & Webhook Settings
PORT=5000
REPLY_UNKNOWN_COMMANDS=False

# Macro Configuration
LOGIN_MACRO_SCRIPT=login_bms.json
# Private credentials used by Macro Tool option 4. Keep these only in your .env.
BMS_USERNAME=
BMS_PASSWORD=

# Auto Logout Configuration (only after LINE accepts image delivery)
ENABLE_AUTO_LOGOUT=False
LOGOUT_MACRO_SCRIPT=logout.json

# Detector Configuration
DETECTOR_INTERVAL_SEC=10
CONFIDENCE_THRESHOLD=0.8

# Required webhook authentication (LINE Developers > Basic settings > Channel secret)
LINE_CHANNEL_SECRET=

# Private bearer token for POST /internal/update-tunnel (disabled if blank)
INTERNAL_API_TOKEN=

# Desktop recording and timing
# Optional metadata for importing old macros; playback does not check display size.
DESKTOP_WIDTH=3000
DESKTOP_HEIGHT=2000
MACRO_SETTLE_DELAY=2.0
# Legacy compatibility only; the bot does not poll after a login macro.
LOGIN_WAIT_SECONDS=5
# Macro limit; interactive image requests must still begin within 45 seconds.
MAX_MACRO_SECONDS=35
TIMEZONE=Asia/Bangkok
# WebP delivery keeps the full screenshot resolution; report JPEGs stay private.
LINE_WEBP_QUALITY=90
# 0 keeps public image links available without expiration. Files are never auto-deleted.
# Optional: set a positive number to expire public links only (604800 = 7 days).
IMAGE_TTL_SECONDS=0
